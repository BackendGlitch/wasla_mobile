{
  "expo": {
    "name": "Wasla",
    "slug": "wasla_mobile",
    "owner": "BackendGlitch",
    "version": "1.0.0",
    "description": "Wasla — Your seamless intercity travel companion. Book bus tickets across Tunisia.",
    "orientation": "portrait",
    "icon": "./assets/img.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "wasla",
    "splash": {
      "image": "./assets/img.png",
      "resizeMode": "contain",
      "backgroundColor": "#141210"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.backendglitch.wasla",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img.png",
        "backgroundColor": "#141210"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.backendglitch.wasla"
    },
    "web": {
      "favicon": "./assets/img.png",
      "bundler": "metro"
    },
    "extra": {
      "author": "BackendGlitch",
      "contactEmail": "contact@backendglitch.com"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/img.png",
          "backgroundColor": "#141210",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-router"
    ]
  }
}
