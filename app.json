{
  "expo": {
    "name": "Wasla",
    "slug": "wasla_mobile",
    "owner": "BackendGlitch",
    "version": "1.0.0",
    "description": "Wasla — Your seamless intercity travel companion. Book bus tickets across Tunisia.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "wasla",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00C1B3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.backendglitch.wasla"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00C1B3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.backendglitch.wasla"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "author": "BackendGlitch",
      "contactEmail": "contact@backendglitch.com"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-router"
    ]
  }
}
